{
  "name": "@aviala-design/tokens",
  "version": "2.5.0",
  "description": "Aviala Design tokens and theme engine for Spiral 2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AvialaOSS/spiral-2.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./ald-theme.css": "./dist/ald-theme.css",
    "./vite-plugin": {
      "types": "./vite-plugin.d.mts",
      "default": "./vite-plugin.mjs"
    },
    "./button-effects.css": "./dist/button-effects.css",
    "./input-effects.css": "./dist/input-effects.css",
    "./basic-input-effects.css": "./dist/basic-input-effects.css",
    "./color-picker-effects.css": "./dist/color-picker-effects.css",
    "./loading-effects.css": "./dist/loading-effects.css",
    "./icon-effects.css": "./dist/icon-effects.css",
    "./typeface-effects.css": "./dist/typeface-effects.css",
    "./cascader-effects.css": "./dist/cascader-effects.css",
    "./popover-effects.css": "./dist/popover-effects.css",
    "./modal-effects.css": "./dist/modal-effects.css",
    "./tooltip-effects.css": "./dist/tooltip-effects.css",
    "./list-effects.css": "./dist/list-effects.css",
    "./datepicker-effects.css": "./dist/datepicker-effects.css",
    "./navigation-effects.css": "./dist/navigation-effects.css",
    "./tab-effects.css": "./dist/tab-effects.css",
    "./focus-effects.css": "./dist/focus-effects.css",
    "./feedback-effects.css": "./dist/feedback-effects.css",
    "./alert-effects.css": "./dist/alert-effects.css",
    "./badge-effects.css": "./dist/badge-effects.css",
    "./progress-effects.css": "./dist/progress-effects.css",
    "./layout-effects.css": "./dist/layout-effects.css",
    "./information-display-extras.css": "./dist/information-display-extras.css",
    "./information-collect-extras.css": "./dist/information-collect-extras.css",
    "./structure-navigation-extras.css": "./dist/structure-navigation-extras.css",
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./tailwind.preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "import": "./dist/tailwind.preset.js"
    }
  },
  "files": [
    "dist",
    "source",
    "vite-plugin.mjs",
    "vite-plugin.d.mts",
    "scripts/css-lib.mjs"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aviala-design/color": "^0.5.15"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
