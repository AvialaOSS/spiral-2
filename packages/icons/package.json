{
  "name": "@aviala-design/icons",
  "version": "2.4.0",
  "description": "Aviala Design Icons for Spiral 2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AvialaOSS/spiral-2.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "raw"
  ],
  "scripts": {
    "build": "node scripts/build-icons.mjs --merge && tsup",
    "build:icons": "node scripts/build-icons.mjs",
    "build:release": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist src/components src/catalog.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "^19.1.8",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
